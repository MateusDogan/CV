%-------------------------
% loader.sty - Resume Core
%-------------------------
\ProvidesPackage{loader}

\RequirePackage[utf8]{inputenc}   % Lê o arquivo .tex corretamente
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}          % Fonte vetorial: sem ela o T1 cai em fonte bitmap, borrada e pior para o ATS
%-------------------------
% PACKAGES & DEPENDENCIES
%-------------------------
\RequirePackage[empty]{fullpage}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage[usenames,dvipsnames]{color}
\RequirePackage[brazilian]{babel}

%-------------------------
% ATS UNICODE MAPPING
%-------------------------
\input{glyphtounicode}
\pdfgentounicode=1

%-------------------------
% PAGE LAYOUT (MARGINS)
%-------------------------
\RequirePackage[top=15mm,bottom=15mm,left=15mm,right=15mm,nohead,nofoot]{geometry}

%-------------------------
% GLOBAL STYLES
%-------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}
\urlstyle{same}

%-------------------------
% SECTION FORMATTING (CORRIGIDO)
%-------------------------
% Mantive a remoção do \scshape (que atrapalha o ATS) e substituí por \bfseries.
% A fonte volta a ser a padrão (Computer Modern), sem forçar Helvetica/Arial.
\titleformat{\section}{
  \vspace{-4pt}\bfseries\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]
\titlespacing*{\section}{0pt}{9pt}{10pt}

%-------------------------
% LOAD VARIABLES & COMMANDS (from same sty/ folder)
%-------------------------
\RequirePackage{sty/variables}
\RequirePackage{sty/commands}